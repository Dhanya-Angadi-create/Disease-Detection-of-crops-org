# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional administrator claim/override passcode for AgroCare AI admin console.
ADMIN_PASSCODE=

# Supabase Backend Configuration (configure in Settings > Secrets; never commit actual keys)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
